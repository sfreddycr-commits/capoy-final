[Unit]
Description=Periodic mount-restore check for capoy-final-ilvlxb uploads
Requires=docker.service

[Timer]
# Check every 30s — responsive but light (script is idempotent and fast)
OnBootSec=10
OnUnitActiveSec=30
AccuracySec=5
Unit=restore-capoy-uploads.service

[Install]
WantedBy=timers.target
